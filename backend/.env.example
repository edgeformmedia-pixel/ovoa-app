# --- Speech-to-text (optional; falls back to a mock transcriber when unset) ---
DEEPGRAM_API_KEY=

# --- Text-to-speech (optional; /v1/tts returns 503 when unset) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
