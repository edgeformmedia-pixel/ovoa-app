{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Workers Logs: every console line and every invocation, kept 3 days on the
  // free plan and 7 on paid, readable in the dashboard and by `wrangler tail`.
  // Sampling is left at 1 (everything) because this Worker serves one person.
  // It is not a substitute for the tables in migrations/0030: there is no query
  // API, it cannot be reached from a phone, and a week is not long enough to
  // answer "has this been happening since the build went out".
  "observability": { "enabled": true },
  // The agent's heartbeat. Every two minutes is what makes "at 7:30" mean 7:30
  // rather than somewhere in the next quarter hour; a tick with nothing due is
  // one indexed read and costs nothing. 04:13 UTC is the nightly tidy-up —
  // an odd minute on purpose, so it isn't queued behind everyone else's 04:00.
  "triggers": { "crons": ["*/2 * * * *", "13 4 * * *"] },
  "vars": {
    // Flash for both: the Gemini key is on the free tier, which allows no Pro requests.
    "CHAT_MODEL": "gemini-3.8-flash",
    "MEMORY_MODEL": "gemini-3.8-flash",
    // Used when Gemini fails or runs out, if DEEPSEEK_API_KEY is set.
    "DEEPSEEK_MODEL": "deepseek-flash",
    // Which keyed engine is tried first: "deepseek" or "gemini". DeepSeek since
    // 2026-09-21: the Gemini key is on the free tier (20 requests) and kept 429ing.
    "PRIMARY_ENGINE": "deepseek",
    // Spoken turns go to Workers AI first: measured first token 1.0-2.9 s there
    // against 4.3-14.1 s on the free-tier Gemini key. Set to "keyed" to undo this
    // once a keyed engine is funded and actually faster.
    "VOICE_PRIMARY": "workers",
    // Cloudflare Workers AI: the last resort when the keyed models fail or aren't set.
    // @cf/zai-org/glm-5.3-flash works here too (needs the Workers Paid plan), and
    // the table can override this without a deploy (server_settings.workers_model).
    "FALLBACK_MODEL": "@cf/openai/gpt-oss-120b",
    // GLM 5.3 Flash from the user's own provider (llm.ts). The key is a secret
    // (GLM_API_KEY); without it the engine does not exist. The base URL is any
    // OpenAI-compatible endpoint, Z.ai's by default, and the model id is the
    // provider's own (OpenRouter calls it z-ai/glm-5.3-flash). Its price comes
    // from pricing.ts unless GLM_PRICE_IN_PER_M / GLM_PRICE_OUT_PER_M /
    // GLM_PRICE_CACHED_PER_M say otherwise (dollars per million tokens).
    "GLM_BASE_URL": "https://api.z.ai/api/paas/v4",
    "GLM_MODEL": "glm-5.3-flash",
    // How much the thinking models think on a typed turn: "off", "low" or "on".
    // Spoken turns never think; the wait before the first word is the whole
    // experience there. Thinking is billed as output tokens, at the output price.
    "GLM_THINKING": "low",
    "DEEPSEEK_THINKING": "low",
    // ENGINE_ORDER, e.g. "glm,deepseek,gemini,workers", would replace PRIMARY_ENGINE
    // above. Left unset: the order is set at run time instead (Dev tools, or
    // PUT /debug/engines), which needs no deploy.
    // Which engine voices replies (voice.ts TTS_ENGINES): deepgram-aura-2 (the
    // default; the voice is the product), workers-aura-2, workers-aura-1,
    // workers-melotts, or device (the phone speaks with its own voices).
    // server_settings.tts_engine, set from Dev tools, overrides this without a deploy.
    "TTS_ENGINE": "deepgram-aura-2",
    // What transcribes recorded clips (the band's button, the recorded fallback):
    // "deepgram" (Nova-3, $0.0043/min) or "workers-whisper" ($0.0005/min, with
    // Deepgram as the fallback when it fails). server_settings.stt_clip_engine overrides it.
    "STT_CLIP_ENGINE": "deepgram",
    // Which web search route goes first (web.ts): "auto" is Gemini's grounding
    // when there is a key (paid past 5K a month), else DuckDuckGo's snippets;
    // "duckduckgo" stops paying for grounding; "gemini" insists on it. Answers
    // are kept for half an hour either way, and a reply may search twice.
    "SEARCH_ENGINE": "auto",
    "PUBLIC_URL": "https://jarvis-api.edgeformmedia.workers.dev",
    // The only accounts allowed the dev-only capture-everything flag (always-listening
    // experiments, ruled out for the product on 2026-09-20). Comma-separated.
    "DEV_EMAILS": "tlanch2006@gmail.com",
    // Google OAuth web client (not secret). GOOGLE_CLIENT_SECRET and TOKEN_ENC_KEY are secrets.
    "GOOGLE_CLIENT_ID": "736336639952-r4qknf5arp9e6m0tj8hvecsjjhauhouq.apps.googleusercontent.com"
  },
  "ai": { "binding": "AI" },
  // Per-person and per-address limits on the routes that spend shared quota
  // (src/limits.ts). Counted per Cloudflare location, no database writes, and set
  // well above what a person can reach by talking: they exist for runaways and
  // scripts. Period is 10 or 60 seconds; namespace_id is any number unique here.
  "ratelimits": [
    // Sign-in and sign-up, per address and per account being signed into.
    { "name": "RL_AUTH", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    // Chat turns, live-listening tokens, ask-Claude: per person.
    { "name": "RL_TURN", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    // Voicing and transcribing, a sentence or a short clip at a time: per person.
    { "name": "RL_SPEAK", "namespace_id": "1103", "simple": { "limit": 120, "period": 60 } },
    // Log uploads, per address. A phone sends at most one every 3 s.
    { "name": "RL_LOGS", "namespace_id": "1104", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-db",
      "database_id": "96162569-6625-4cad-af9c-62a3f6820033",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `npx wrangler secret put NAME`): GEMINI_API_KEY, DEEPSEEK_API_KEY, GLM_API_KEY, GOOGLE_CLIENT_SECRET,
  // TOKEN_ENC_KEY, DEEPGRAM_API_KEY, DEBUG_KEY, and SHORTCUT_SIGNING_URL (+ optional SHORTCUT_SIGNING_TOKEN) to turn on
  // shortcut writing (see README).
}
