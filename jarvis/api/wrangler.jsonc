{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The Cloudflare account, pinned: admin@ovoa.ai's, since the move in the v1
  // release (2026-09). A pinned id beats CLOUDFLARE_ACCOUNT_ID and wrangler's
  // account cache, so every deploy, secret and D1 command run from this folder
  // lands here or fails, never on another account. Run them with the profile
  // logged in to it (XDG_CONFIG_HOME=C:/Users/thoma/.wrangler-ovoa). The old
  // edgeformmedia account (33594882ed1877edb5cee6f495ca7fae) now holds only the
  // forwarder (../forwarder) and the old D1 as a backup, both until 2026-10-14.
  "account_id": "e58b0ec5305410f9d3cd70f461f39cb6",
  // Served at api.ovoa.ai, a custom domain on the ovoa.ai zone in this account.
  // workers_dev has to be written out: once there are routes, wrangler turns the
  // workers.dev address off unless told to keep it, and it is the second way in
  // (a check while api.ovoa.ai's certificate is still being issued).
  "routes": [{ "pattern": "api.ovoa.ai", "custom_domain": true }],
  "workers_dev": true,
  // Workers Logs: every console line and every invocation, kept 3 days on the
  // free plan and 7 on paid, readable in the dashboard and by `wrangler tail`.
  // Sampling is left at 1 (everything) because this Worker serves one person.
  // It is not a substitute for the tables in migrations/0030: there is no query
  // API, it cannot be reached from a phone, and a week is not long enough to
  // answer "has this been happening since the build went out".
  "observability": { "enabled": true },
  // The agent's heartbeat. Every two minutes is what makes "at 7:30" mean 7:30
  // rather than somewhere in the next quarter hour; a tick with nothing due is
  // one indexed read and costs nothing. 04:13 UTC is the nightly tidy-up —
  // an odd minute on purpose, so it isn't queued behind everyone else's 04:00.
  "triggers": { "crons": ["*/2 * * * *", "13 4 * * *"] },
  "vars": {
    // Every model call tries GLM first and Gemini second (llm.ts ENGINES); these
    // two are the Gemini model it calls. Gemini 3.5 Flash-Lite for both, on the
    // paid key; the id is the one GET v1beta/models listed for that key
    // (2026-09-23). CHAT_MODEL also does web search grounding (web.ts).
    "CHAT_MODEL": "gemini-3.5-flash-lite",
    "MEMORY_MODEL": "gemini-3.5-flash-lite",
    // GLM 5.3 Flash from the user's own provider (llm.ts OPENAI_PROVIDERS). The
    // key is a secret (GLM_API_KEY); without it the engine does not exist. The
    // base URL is any OpenAI-compatible endpoint, Z.ai's by default, and the
    // model id is the provider's own (OpenRouter calls it z-ai/glm-5.3-flash).
    // Its price comes from pricing.ts unless GLM_PRICE_IN_PER_M /
    // GLM_PRICE_OUT_PER_M / GLM_PRICE_CACHED_PER_M say otherwise (dollars per
    // million tokens).
    "GLM_BASE_URL": "https://api.z.ai/api/paas/v4",
    "GLM_MODEL": "glm-5.3-flash",
    // How much GLM thinks on a typed turn: "off", "low" or "on". Spoken turns
    // never think; the wait before the first word is the whole experience there.
    // Thinking is billed as output tokens, at the output price.
    "GLM_THINKING": "low",
    // ENGINE_ORDER, e.g. "gemini,glm", would put Gemini first. Left unset: GLM
    // first. The order can also be set at run time (Dev tools, or
    // PUT /debug/engines), which needs no deploy.
    // Which engine voices replies (voice.ts TTS_ENGINES): deepgram-aura-2 (the
    // default; the voice is the product) or device (the phone speaks with its
    // own voices). server_settings.tts_engine, set from Dev tools, overrides
    // this without a deploy.
    "TTS_ENGINE": "deepgram-aura-2",
    // Where the site answers "which plan is this email on?" (plans.ts, SPEC §2).
    // Point it at the site's test Worker to try a flow end to end. The key is the
    // secret MEMBERSHIP_API_KEY; until it is set everyone is treated as pro, so
    // no tester is locked out by the plans shipping before the site does. The
    // daily and monthly allowances per plan are constants in plans.ts, with the
    // arithmetic (the monthly one used to be TURN_CAP_MONTHLY here).
    "MEMBERSHIP_URL": "https://ovoa.ai/api/public/membership",
    // Which web search route goes first (web.ts): "auto" is Gemini's grounding
    // when there is a key (paid past 5K a month), else DuckDuckGo's snippets;
    // "duckduckgo" stops paying for grounding; "gemini" insists on it. Answers
    // are kept for half an hour either way, and a reply may search twice.
    "SEARCH_ENGINE": "auto",
    // The address this Worker gives out: Google's redirect back
    // (/google/callback, registered in Google Cloud), the Siri key and shortcut
    // file links. The old workers.dev address still works through the forwarder
    // until 2026-10-14; nothing new should be handed that one.
    "PUBLIC_URL": "https://api.ovoa.ai",
    // The moving switch (src/maintenance.ts): "on" answers every request 503
    // and skips every cron tick while the data is copied between accounts.
    // Turn it on for one deploy with `npx wrangler deploy --var MAINTENANCE:on`;
    // the next plain deploy reads "off" from here.
    "MAINTENANCE": "off",
    // The only accounts allowed the dev-only capture-everything flag (always-listening
    // experiments, ruled out for the product on 2026-09-20). Comma-separated.
    "DEV_EMAILS": "tlanch2006@gmail.com",
    // Google OAuth web client (not secret). GOOGLE_CLIENT_SECRET and TOKEN_ENC_KEY are secrets.
    "GOOGLE_CLIENT_ID": "736336639952-r4qknf5arp9e6m0tj8hvecsjjhauhouq.apps.googleusercontent.com"
  },
  // Per-person and per-address limits on the routes that spend shared quota
  // (src/limits.ts). Counted per Cloudflare location, no database writes, and set
  // well above what a person can reach by talking: they exist for runaways and
  // scripts. Period is 10 or 60 seconds; namespace_id is any number unique here.
  "ratelimits": [
    // Sign-in and sign-up, per address and per account being signed into.
    { "name": "RL_AUTH", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    // Chat turns, live-listening tokens, ask-Claude: per person.
    { "name": "RL_TURN", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
    // Voicing and transcribing, a sentence or a short clip at a time: per person.
    { "name": "RL_SPEAK", "namespace_id": "1103", "simple": { "limit": 120, "period": 60 } },
    // Log uploads, per address. A phone sends at most one every 3 s.
    { "name": "RL_LOGS", "namespace_id": "1104", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-db",
      // The new account's jarvis-db. The old one (96162569-6625-4cad-af9c-62a3f6820033)
      // stays on the old account, untouched, as the backup until 2026-10-14.
      "database_id": "26ebdc31-740f-4191-905d-77a5edb97799",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `XDG_CONFIG_HOME=C:/Users/thoma/.wrangler-ovoa npx wrangler secret put NAME`): GEMINI_API_KEY, GLM_API_KEY, GOOGLE_CLIENT_SECRET,
  // TOKEN_ENC_KEY, DEEPGRAM_API_KEY, DEBUG_KEY, MEMBERSHIP_API_KEY, and SHORTCUT_SIGNING_URL (+ optional SHORTCUT_SIGNING_TOKEN) to turn on
  // shortcut writing (see README). RESEND_API_KEY sends ovoa.ai's sign-in codes from no-reply@ovoa.ai, and the optional
  // GOOGLE_SIGNIN_CLIENT_IDS accepts Google sign-ins from another OAuth client than GOOGLE_CLIENT_ID (src/emailauth.ts).
}
