{
  "expo": {
    "name": "OVOA",
    "slug": "ovoa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ovoa.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "OVOA connects to your ES100 recorder over Bluetooth to pull in what it captured.",
        "UIBackgroundModes": [
          "audio",
          "bluetooth-central",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "OVOA counts your steps and detects falls using motion data."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OVOA includes your location in emergency alerts.",
          "locationAlwaysAndWhenInUsePermission": "OVOA learns the places you go, like home and work, so it can remind you of things when you arrive or leave. Your location stays in your OVOA account and is kept for 14 days.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "OVOA looks up, adds, and edits contacts when you ask the assistant to."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "OVOA reads and adds calendar events when you ask the assistant to.",
          "remindersPermission": "OVOA reads and adds reminders when you ask the assistant to."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "OVOA reads your steps, heart rate, sleep, and workouts to answer your questions about them.",
          "NSHealthUpdateUsageDescription": "OVOA does not write to Apple Health. iOS requires this message because the Health library OVOA uses can save data.",
          "background": true
        }
      ],
      "expo-live-activity",
      [
        "expo-notifications",
        {
          "color": "#22E2FF",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-mail-composer",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "OVOA listens when you tap the mic, or all the time if you turn on Always listen, so you can talk to the assistant.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#07090D"
        }
      ]
    ],
    "scheme": "ovoa",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "com.ovoa.app.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "0b8dbbc9-74e0-40ac-b8aa-70048182afcf"
      }
    },
    "owner": "tlanch"
  }
}
